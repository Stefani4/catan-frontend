# Copy this file to .env (local dev) or .env.production (before building
# for deploy), and set VITE_SERVER_URL to wherever your boardgame.io server
# is actually reachable. Leave it unset to keep using localhost:8000.
#
# Local dev, same machine:
# VITE_SERVER_URL=http://localhost:8000
#
# Quick test via a tunnel (e.g. ngrok):
# VITE_SERVER_URL=https://your-subdomain.ngrok-free.app
#
# Real deploy (e.g. Render/Railway/Fly.io):
# VITE_SERVER_URL=https://catan-server.onrender.com

VITE_SERVER_URL=
